# PostgreSQL (used by docker-compose db service + backend)
POSTGRES_USER=careeros
POSTGRES_PASSWORD=careeros
POSTGRES_DB=careeros
POSTGRES_PORT=5432

# --- Clerk auth (get these from dashboard.clerk.com -> API Keys) ---
CLERK_ISSUER=https://YOUR_APP.clerk.accounts.dev
CLERK_JWKS_URL=https://YOUR_APP.clerk.accounts.dev/.well-known/jwks.json
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_SECRET_KEY
